#: src/stream.ts:262
msgid ""
"File uses a format that cannot be played. Additional media codecs may be "
"required."
msgstr ""
"Fila brukar eit format som ikkje kan spelast av. Det kan vere nødvendig med "
"fleire mediekodekar."

#: src/stream.ts:274
msgid ""
"An error happened while trying to get information about the file. Please try "
"again."
msgstr ""
"Det oppstod ein feil under henting av informasjon om fila. Prøv på nytt."

#: src/stream.ts:285
msgid "File uses an invalid URI"
msgstr "Fila brukar ein ugyldig URI"

#: src/stream.ts:296
msgid "Reading the file’s information timed out. Please try again."
msgstr "Tida for å lese filinformasjonen gjekk ut. Prøv på nytt."

#: src/stream.ts:404
msgid "Unknown File"
msgstr "Ukjend fil"

#: src/stream.ts:649
msgid "The selected file doesn’t contain any audio"
msgstr "Den valde fila inneheld ingen lyd"

