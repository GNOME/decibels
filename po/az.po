#: src/stream.ts:261
msgid ""
"File uses a format that cannot be played. Additional media codecs may be "
"required."
msgstr ""
"Fayl oxudula bilməyən formatdan istifadə edir. Əlavə media kodekləri tələb "
"oluna bilər."

#: src/stream.ts:273
msgid ""
"An error happened while trying to get information about the file. Please try "
"again."
msgstr "Fayl haqqında məlumat əldə edərkən xəta baş verdi. Yenidən cəhd edin."

#: src/stream.ts:284
msgid "File uses an invalid URI"
msgstr "Fayl etibarsız URI istifadə edir"

#: src/stream.ts:295
msgid "Reading the file’s information timed out. Please try again."
msgstr ""
"Fayl məlumatının oxudulmasının vaxtı bitdi. Zəhmət olmasa, yenidən cəhd edin."

#: src/stream.ts:403
msgid "Unknown File"
msgstr "Naməlum fayl"

#: src/stream.ts:641
msgid "The selected file doesn’t contain any audio"
msgstr "Seçilmiş faylda səs yoxdur"

#: src/volume-button.ts:56
msgid "Muted"
msgstr "Səssiz"

#: src/volume-button.ts:57
msgid "Full Volume"
msgstr "Tam həcm"

