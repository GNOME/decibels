msgid "Pause"
msgstr "ຢຸດຊົ່ວຄາວ"

#: src/player.ts:120
msgid "Play"
msgstr "ຫຼິ້ນ"

#: src/window.ts:132
msgid "Audio files"
msgstr "ໄຟລ໌ສຽງ"

#: src/window.ts:139
msgid "Open File"
msgstr "ເປີດໄຟລ໌"

#: src/window.ts:178
