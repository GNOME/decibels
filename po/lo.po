msgstr "translator-credits"

#: src/drag-overlay.ts:70
msgid "Unable to access dropped files"
msgstr "ບໍ່ສາມາດເຂົ້າເຖິງໄຟລ໌ທີ່ລາກມາໄດ້"

#: src/error.ts:42
msgid "An unknown error happened"
msgstr "ເກີດຂໍ້ຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#: src/stream.ts:271
msgid ""
"File uses a format that cannot be played. Additional media codecs may be "
"required."
msgstr "ໄຟລ໌ນີ້ໃຊ້ຮູບແບບທີ່ບໍ່ສາມາດຫຼິ້ນໄດ້. ອາດຈະຕ້ອງຕິດຕັ້ງໂຄເດັກສື່ເພີ່ມເຕີມ."

#: src/stream.ts:283
msgid ""
"An error happened while trying to get information about the file. Please try "
"again."
msgstr "ເກີດຂໍ້ຜິດພາດຂະນະພະຍາຍາມເອົາຂໍ້ມູນກ່ຽວກັບໄຟລ໌. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: src/stream.ts:294
msgid "File uses an invalid URI"
msgstr "ໄຟລ໌ໃຊ້ URI ທີ່ບໍ່ຖືກຕ້ອງ"

#: src/stream.ts:305
msgid "Reading the file’s information timed out. Please try again."
msgstr "ການອ່ານຂໍ້ມູນໄຟລ໌ໝົດເວລາ. ກະລຸນາລອງໃໝ່ອີກຄັ້ງ."

#: src/stream.ts:421
msgid "Unknown File"
msgstr "ບໍ່ຮູ້ຈັກໄຟລ໌"

#: src/stream.ts:667
msgid "The selected file doesn’t contain any audio"
msgstr "ໄຟລ໌ທີ່ເລືອກບໍ່ມີຂໍ້ມູນສຽງ"

#: src/volume-button.ts:57
msgid "Muted"
msgstr "ປິດສຽງ"

#: src/volume-button.ts:58
msgid "Full Volume"
msgstr "ລະດັບສຽງສູງສຸດ"

