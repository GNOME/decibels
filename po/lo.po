msgid "New Window"
msgstr "ໜ້າຕ່າງໃໝ່"

#: data/shortcuts-dialog.blp:19
msgctxt "shortcut window"
msgid "Quit"
msgstr "ອອກ"

#: data/shortcuts-dialog.blp:25
msgctxt "shortcut window"
