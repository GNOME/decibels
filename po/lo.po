msgstr "ບໍ່ພົບໄຟລ໌ສຽງທີ່ສາມາດໃຊ້ໄດ້"

#: src/window.ts:190
msgid "Directories Cannot Be Played"
msgstr "ບໍ່ສາມາດຫຼິ້ນໂຟລເດີໄດ້"

#: src/window.ts:191
msgid "Please select a file."
msgstr "ກະລຸນາເລືອກໄຟລ໌."

#: src/window.ts:197
msgid "The selected file is not a regular file."
msgstr "ໄຟລ໌ທີ່ເລືອກບໍ່ແມ່ນໄຟລ໌ທຳມະດາ."

#: src/window.ts:217
msgid "No file was selected"
msgstr "ບໍ່ມີໄຟລ໌ໃດຖືກເລືອກ"
